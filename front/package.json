{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "back:e2e": "cd ../back && ./scripts/init-e2e-db.sh && ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev,local,e2e",
    "e2e:db:init": "cd ../back && ./scripts/init-e2e-db.sh",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e:open": "start-server-and-test start http-get://localhost:4200 cy:open",
    "e2e": "start-server-and-test start http-get://localhost:4200 cy:run",
    "report:merge": "mochawesome-merge cypress/reports/*.json -o cypress/reports/merged.json && marge cypress/reports/merged.json -f rapport-e2e -o cypress/reports",
    "e2e:report": "(npm run e2e || true) && npm run report:merge"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "~22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "angular-eslint": "22.5.0",
    "cypress": "^16.2.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.2",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "start-server-and-test": "^3.0.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
